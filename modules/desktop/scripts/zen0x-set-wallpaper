#!/usr/bin/env bash
set -euo pipefail

WALLPAPER_LINK="$HOME/.config/hypr/wallpaper"

if [[ $# -lt 1 ]]; then
  echo "Usage: zen0x-set-wallpaper <path>" >&2
  exit 1
fi

PATH_ARG="$(realpath "$1")"

if [[ ! -f "$PATH_ARG" ]]; then
  echo "File not found: $PATH_ARG" >&2
  exit 1
fi

mkdir -p "$(dirname "$WALLPAPER_LINK")"
ln -sf "$PATH_ARG" "$WALLPAPER_LINK"

# Ensure the daemon is running before setting the image.
if ! awww query >/dev/null 2>&1; then
  awww-daemon &
  for _ in $(seq 20); do
    awww query >/dev/null 2>&1 && break
    sleep 0.1
  done
fi

awww img "$PATH_ARG" \
  --transition-type grow \
  --transition-pos center \
  --transition-fps 60 \
  --transition-duration 1
